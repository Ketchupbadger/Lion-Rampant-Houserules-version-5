<?xml5bs dataVersion="1.0"?>
<catalogue id="lion-rampant-custom" name="Lion Rampant: Custom Houserules" revision="1" battleScribeVersion="2.03" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  
  <!-- CONSTRAINTS & RESTRICTIONS -->
  <entryLinks/>
  <sharedSelectionEntries>
    
    <!-- RETINUE UPGRADES -->
    <selectionEntry id="upgrade-inspiring" name="Inspiring Personality" book="Houserules" hidden="false" collective="false" import="true" type="upgrade">
      <costs>
        <cost name="Points" typeId="points" value="1"/>
      </costs>
      <comment>The unit is joined (swap one model) by an inspiring personality. The unit improves its Courage by +1 whilst the personality is alive. Susceptible to Lucky Blows.</comment>
    </selectionEntry>

    <selectionEntry id="upgrade-captain" name="Captain" book="Houserules" hidden="false" collective="false" import="true" type="upgrade">
      <costs>
        <cost name="Points" typeId="points" value="1"/>
      </costs>
      <comment>1 Unit in the army may be joined by a captain (swap one model). The unit doesn’t cause a turn-over on a failed order test whilst the captain is alive. Susceptible to Lucky Blows.</comment>
    </selectionEntry>

    <selectionEntry id="upgrade-renown" name="Renown Reputation" book="Houserules" hidden="false" collective="false" import="true" type="upgrade">
      <costs>
        <cost name="Points" typeId="points" value="1"/>
      </costs>
      <comment>1 Unit in the army may be of renown reputation. Whilst this unit is not Battered, enemy units within 6 inches of this unit suffer a -1 penalty to their Courage.</comment>
    </selectionEntry>

    <!-- UNITS -->
    <!-- 1. Elite Cavalry -->
    <selectionEntry id="unit-elite-cavalry" name="Elite Cavalry" hidden="false" collective="false" import="true" type="unit">
      <profiles>
        <profile id="prof-elite-cav" name="Elite Cavalry" hidden="false" typeId="unit-stats">
          <characteristics>
            <characteristic name="Cost" typeId="cost">6</characteristic>
            <characteristic name="Move Order" typeId="move-order">7+</characteristic>
            <characteristic name="Max Move" typeId="max-move">10&quot;</characteristic>
            <characteristic name="Shoot Order" typeId="shoot-order">-</characteristic>
            <characteristic name="Shoot Value" typeId="shoot-val">-</characteristic>
            <characteristic name="Attack Order" typeId="attack-order">5+</characteristic>
            <characteristic name="Attack Value" typeId="attack-val">3+</characteristic>
            <characteristic name="Def Value" typeId="def-val">5+</characteristic>
            <characteristic name="Armor" typeId="armor">4</characteristic>
            <characteristic name="Courage" typeId="courage">3+</characteristic>
            <characteristic name="Special Rules" typeId="rules">Counter-Charge; Wild Charge</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <costs><cost name="Points" typeId="points" value="6"/></costs>
    </selectionEntry>

